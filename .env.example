# Local development only; never expose the database or API publicly.
STUDYCHAT_DATABASE_URL=postgresql://studychat:local-studychat@127.0.0.1:54329/studychat
STUDYCHAT_PROVIDER_MODE=fixture
STUDYCHAT_STORAGE_DIR=data/documents
# Opt-in live mode (restart API after changing). Never commit the real key.
# STUDYCHAT_PROVIDER_MODE=live
# STUDYCHAT_OPENAI_API_KEY=replace-locally
# STUDYCHAT_CHAT_MODEL=gpt-5.4-mini-2026-03-17
# Threshold is experimental until calibrated on separate development questions.
STUDYCHAT_SIMILARITY_THRESHOLD=0.25
STUDYCHAT_THRESHOLD_LABEL=untuned
# GPT-5.4 mini uses low reasoning effort; this cap includes reasoning and answer tokens.
STUDYCHAT_MAX_OUTPUT_TOKENS=4000
